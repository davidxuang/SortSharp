<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.*" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="OneOf" Version="3.0.*" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="PolySharp" Version="1.16.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SortSharp\IKeySelector.cs" Link="Link\%(FileName)%(Extension)" />
    <Compile Include="..\SortSharp\Foundation\Dispatcher.cs" Link="Link\%(FileName)%(Extension)" />
    <Compile Include="..\SortSharp\Compat\BclPolyfills.cs" Link="Link\%(FileName)%(Extension)" />
    <Compile Include="..\SortSharp\SourceGenerators\*.cs" Link="Link\%(FileName)%(Extension)" />
  </ItemGroup>

  <!-- <PropertyGroup>
    <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths</GetTargetPathDependsOn>
  </PropertyGroup>

  <Target Name="GetDependencyTargetPaths" AfterTargets="ResolvePackageDependenciesForBuild">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="@(ResolvedCompileFileDefinitions)" IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target> -->

</Project>
